# ========================
# 1. DeepSeek API 配置（必填）
# ========================
DEEPSEEK_API_KEY=sk-你的DeepSeek-API-Key
# 使用 BOT_DEEPSEEK_BASE_URL 避免与 DSH CLI .env 启动安全检查冲突
BOT_DEEPSEEK_BASE_URL=https://api.deepseek.com

# 聊天模型 & 识图多模态模型
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash

# 可选：自定义视觉模型覆盖与智谱免费高精度看图 Key
ZHIPU_API_KEY=
VISION_API_KEY=
VISION_BASE_URL=

# ========================
# 2. Grok 锐评核查模式与半主动唤醒规则
# ========================
BOT_NAME=大肥鱼
TRIGGER_KEYWORDS=@大肥鱼
GROUP_AT_ONLY=true
# 单发图片无文字时偶尔主动看图锐评概率（0.0 ~ 1.0）
AUTO_ROAST_IMAGE_PROB=0.25
# 回复时附带表情包概率（Grok 模式默认 0.0 纯文字利落输出）
STICKER_REPLY_PROB=0.0

# 连发去抖合并
ENABLE_TRIGGER_DEBOUNCE=true
TRIGGER_DEBOUNCE_SEC=4.0
TRIGGER_DEBOUNCE_MAX_WAIT_SEC=12
TRIGGER_BURST_MAX_ITEMS=5

# L2 上下文追认窗口（秒）与 L2.5 兴趣点半主动锐评雷达
FOLLOWUP_WINDOW_SEC=300
ENABLE_TOPIC_INTEREST=true
TOPIC_GAP_SEC=600
TOPIC_INTEREST_MIN_SCORE=0.75

# HeartFlow 群聊多人热议半主动补刀
ENABLE_PROACTIVE_CHIME=true
PROACTIVE_COOLDOWN_SEC=600

# 夜间静默期（默认凌晨 1:00 ~ 8:00 不做半主动插嘴，被 @ 照常响应）
QUIET_START_HOUR=1
QUIET_END_HOUR=8

# ========================
# 3. 联网核查搜索与四层轻量记忆
# ========================
ENABLE_WEB_SEARCH=true
BOCHA_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

MEMORY_DIARY_INJECT=false
MEMORY_NIGHTLY_EXTRACT=true
L3_INJECT_ALL=1
L3_INJECT_MAX_TOKENS=90000
L3_HISTORY_LIMIT=25
L3_CONTEXT_LIMIT_TOKENS=300000
L3_KEEP_RECENT=120
L3_COMPRESS_CHUNK=200

# ========================
# 4. 接入通道与沙箱后台工兵（DSH / CodeBuddy）
# ========================
RUN_MODE=web
WX_GROUP_WHITELIST=大肥鱼测试群
QQ_GROUP_WHITELIST=
QQ_ONEBOT_TOKEN=

ENABLE_AGENT_TOOLS=true
OWNER_NAMES=
AUTO_GIT_UPDATE=true
AUTO_GIT_POLL_SEC=60
# 分支守护：有人在本地切了分支 / 提交了新代码，就自动重启加载新代码。
# 和上面那个分开：AUTO_GIT_UPDATE 管去远程拉更新，这个只管本地工作区变了。
# 关掉它就得自己重启，否则切了分支机器人还跑着旧分支的代码。
AUTO_BRANCH_WATCH=true
# 重启 / 切分支 / 拉更新时是否往群里播报。默认 false：这些是运维动作，
# 群里不该看到「鱼重启回来啦」「已切到分支 xxx」，日志里留痕就够。
RESTART_NOTICE_ON=false
# 崩溃 / 版本回滚告警（故障信号，不是例行重启），默认保留播报。
RESTART_ALERT_ON=true

ENABLE_DSH=true
TOOL_BACKEND=dsh
DSH_BIN=dsh
DSH_MODE=danger-full-access
DSH_APPROVAL_POLICY=never
DSH_MODEL=
DSH_WORKDIR=
DSH_TIMEOUT_SEC=900
CBC_BIN=
CBC_MODEL=deepseek-v4.1-flash

ENABLE_TOOL_ROUTER=true
TOOL_ROUTER_MIN_CHARS=8
TOOLS_ALL_TO_DSH=true
DSH_REPORT_BY_BOT=true
DSH_ARTIFACT_MAX=5
DSH_ARTIFACT_MAX_MB=20

TOOL_LINK_ENABLED=true
TOOL_LINK_MAX_PER_MSG=2
TOOL_LINK_SEEN_TTL_SEC=7200
TOOL_LINK_TIMEOUT_SEC=180

ENABLE_DANGER_CONFIRM=true
DANGER_CONFIRM_TTL_SEC=180

WEB_HOST=127.0.0.1
WEB_PORT=8765
