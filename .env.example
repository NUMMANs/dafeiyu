# ========================
# 1. DeepSeek API 配置（必填）
# ========================
DEEPSEEK_API_KEY=sk-你的DeepSeek-API-Key
# 使用 BOT_DEEPSEEK_BASE_URL 避免与 DSH CLI .env 启动安全检查冲突
BOT_DEEPSEEK_BASE_URL=https://api.deepseek.com

# 聊天模型 & 识图多模态模型
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash

# 可选：如果你想用其他兼容 OpenAI 格式的视觉模型（如 Qwen-VL / GLM-4V），可单独覆盖下面两项
VISION_API_KEY=
VISION_BASE_URL=

# ========================
# 2. 大肥鱼人设与触发规则
# ========================
BOT_NAME=大肥鱼
# 默认人设（fengge=峰哥亡命天涯，dafeiyu=塔菲大肥鱼；群里可随时 /切换人设 热切换）
DEFAULT_PERSONA=fengge
# 群聊唤醒词（逗号分隔）。默认只认 @ 唤名，不 @ 一律不回复。
# 想恢复"不 @ 也叫得醒"：改成 @大肥鱼,大肥鱼,肥鱼
TRIGGER_KEYWORDS=@大肥鱼
# 群聊中是否仅在 @或叫到名字 时才回复（强烈建议 true，防刷屏省 Token）
GROUP_AT_ONLY=true
# 群友发图片时，即使没 @ 大肥鱼，也有一定概率主动看图吐槽（0.0 ~ 1.0，0 表示必须被叫到才看图）
AUTO_ROAST_IMAGE_PROB=0.35
# 回复时附带大肥鱼表情包的概率（0.0 ~ 1.0）
STICKER_REPLY_PROB=0.75

# L2/L2.5 判定去抖：群里连着发话时先挂起，等这一波说完（停顿）再判定
ENABLE_TRIGGER_DEBOUNCE=true
# 停顿多少秒算「说完了」，之后才执行判定并接话。
# 必须大于群友两句之间的常见间隔：设 4.0 时「3 秒一条」的连发会被合并成一次判定；
# 设太小（如 1.5）会把同一个人连发的两条拆成两次判定。
TRIGGER_DEBOUNCE_SEC=4.0
# 群里一直不停顿时的最大等待（秒），到点强制判定，防止永远排不上
TRIGGER_DEBOUNCE_MAX_WAIT_SEC=12
# 一波连续发言最多合并几句送给判定器（多人接话会带上各自昵称，防止张冠李戴）。
# 攒满这个条数就立刻整批送给判定器，不等停顿；建议与 L2 的 5 条上下文窗口一致。
TRIGGER_BURST_MAX_ITEMS=5

# L2.5 冷场重启话题的吐槽判定（群里安静很久后有人重新开话题，先轻量判断值不值得接一句）
ENABLE_TOPIC_ROAST=true
# 距上一条群消息超过多少秒算「开新话题」，这是 L2.5 唯一的频率控制
TOPIC_GAP_SEC=600
# 判定器打分阈值（0~1，模型输出 0~10 分，低于 阈值×10 不接话）。调到 0.85 更挑剔，0.5 更爱接话
TOPIC_ROAST_MIN_SCORE=0.7

# ========================
# 2.5 自主意识 & 联网搜索配置
# ========================
ENABLE_WEB_SEARCH=true
BOCHA_API_KEY=
TAVILY_API_KEY=
ENABLE_PROACTIVE_CHIME=true
PROACTIVE_MSG_THRESHOLD=6
PROACTIVE_COOLDOWN_SEC=480
ENABLE_SCHEDULED_BUBBLE=true
# 静默期：这段时间绝不主动冒泡/接话。默认 1 点睡到 8 点，0 点留着发每日统计
QUIET_START_HOUR=1
QUIET_END_HOUR=8

# ========================
# 2.5 四层记忆（L1 识海 / L2 日记 / L3 会话）
# ========================
# 每轮是否把本群最近 1~2 条日记当「心情底色」注入 system（约 +40 tk）
MEMORY_DIARY_INJECT=true
# 夜间是否用一次轻量调用从当天群里提炼 L1 事实（关掉就只靠模型自己想起来记）
MEMORY_NIGHTLY_EXTRACT=true
# 每次回复带多少条近期对话（L3 会话层，0 = 不带上下文）
L3_HISTORY_LIMIT=20
# L3 整层占用超过多少 token 就压缩（每天 0 点后按群检查一次）
L3_CONTEXT_LIMIT_TOKENS=300000
# 压缩时绝不参与的最近消息条数
L3_KEEP_RECENT=120
# 一次压缩最多送给模型多少条旧消息
L3_COMPRESS_CHUNK=200

# ========================
# 3. 微信接入配置
# ========================
# 运行模式：
#   web    = 仅启动本地「养鱼控制台 + 模拟微信群」网页（默认，开箱即用）
#   wxauto = 仅运行 Windows PC 微信群监听
#   both   = 同时启动 Web 控制台 + Windows PC 微信群监听（推荐正式养鱼用）
#   ilink  = 使用微信官方 iLink 协议扫码私聊
RUN_MODE=web

# 要监听的微信群名称（多个群用英文逗号分隔，必须与 PC 微信里的群名完全一致）
WX_GROUP_WHITELIST=大肥鱼测试群

# 是否开启桌面 Agent & Git 自动更新（多人大群建议设置 OWNER_NAMES=你的微信名）
ENABLE_AGENT_TOOLS=true
OWNER_NAMES=
AUTO_GIT_UPDATE=true
AUTO_GIT_POLL_SEC=60
ENABLE_DSH=true
DSH_BIN=dsh
DSH_MODE=danger-full-access
DSH_APPROVAL_POLICY=never
DSH_MODEL=
DSH_WORKDIR=
DSH_TIMEOUT_SEC=900
ENABLE_DANGER_CONFIRM=true
DANGER_CONFIRM_TTL_SEC=180

# Web 控制台端口
WEB_HOST=127.0.0.1
WEB_PORT=8765
